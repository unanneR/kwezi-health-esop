@model List<kwezi_health_esop.Models.StaffMember>
@{
    Layout = null;
    ViewData["Title"] = "Staff Directory";
    var editingStaff = ViewBag.EditingStaff as kwezi_health_esop.Models.StaffMember;
    bool isEditing = editingStaff is not null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KweziHealth ESOP</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Enterprise Staff Operations Directory</h2>
            <form asp-controller="Access" asp-action="Logout" method="post">
                <button type="submit" class="btn btn-outline-danger">Logout</button>
            </form>
        </div>

        <!-- Combined Add / Edit Form -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header @(isEditing ? "bg-warning text-dark" : "bg-secondary text-white")">
                @(isEditing ? $"Edit Staff Member (ID: {editingStaff!.StaffId})" : "Add New Staff Member")
            </div>
            <div class="card-body">
                <form asp-controller="Staff" asp-action="@(isEditing ? "Edit" : "Create")" method="post" class="row g-3">

                    @if (isEditing)
                    {
                        <input type="hidden" name="StaffId" value="@editingStaff.StaffId" />
                    }

                    <div class="col-md-3">
                        <label class="form-label small text-muted">Full Name</label>
                        <input name="FullName" value="@(isEditing ? editingStaff.FullName : "")" class="form-control" placeholder="Full Name" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small text-muted">Email</label>
                        <input name="Email" type="email" value="@(isEditing ? editingStaff.Email : "")" class="form-control" placeholder="Email" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small text-muted">Position</label>
                        <input name="Position" value="@(isEditing ? editingStaff.Position : "")" class="form-control" placeholder="Position" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small text-muted">Unit</label>
                        <input name="Unit" value="@(isEditing ? editingStaff.Unit : "")" class="form-control" placeholder="Unit" required />
                    </div>
                    <div class="col-md-1 d-flex align-items-end gap-1">
                        <button type="submit" class="btn @(isEditing ? "btn-warning" : "btn-success") w-100">
                            @(isEditing ? "Update" : "Add")
                        </button>
                        @if (isEditing)
                        {
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        }
                    </div>
                </form>
            </div>
        </div>

        <!-- Staff List Table -->
        <div class="table-responsive">
            <table class="table table-bordered table-striped shadow-sm align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Position</th>
                        <th>Unit</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var staff in Model)
                        {
                            <tr>
                                <td>@staff.StaffId</td>
                                <td>@staff.FullName</td>
                                <td>@staff.Email</td>
                                <td>@staff.Position</td>
                                <td>@staff.Unit</td>
                                <td>
                                    <a asp-controller="Staff" asp-action="Edit" asp-route-id="@staff.StaffId" class="btn btn-sm btn-warning">Edit</a>
                            <form asp-controller="Staff"
                                  asp-action="Delete"
                                  asp-route-id="@staff.StaffId"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Are you sure you want to delete this staff record?');">
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">No staff records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
